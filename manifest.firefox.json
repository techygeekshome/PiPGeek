{
  "manifest_version": 3,
  "name": "PiPGeek: Picture in Picture",
  "short_name": "PiPGeek",
  "version": "1.0.0",
  "description": "Pop the main video on any page out into a floating window with one click or Alt+P. Click again to put it back. No tracking.",
  "permissions": [
    "activeTab",
    "scripting",
    "contextMenus",
    "storage"
  ],
  "background": {
    "scripts": [
      "pipgeek-core.js",
      "background.js"
    ]
  },
  "action": {
    "default_title": "PiPGeek: pop out the video (Alt+P)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+P"
      },
      "description": "Pop the video out, or put it back"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "homepage_url": "https://techygeekshome.info/browser-extensions/pipgeek/",
  "browser_specific_settings": {
    "gecko": {
      "id": "pipgeek@techygeekshome.info",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}